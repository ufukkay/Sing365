{
	# One certificate authority, so the relay knows where its certificate file is.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	# RSA keys: Exchange Online checks the relay's certificate when it hands mail back.
	key_type rsa2048
}

# The public page on the bare domain and www.
{$SIGWIDE_SITE_HOST} www.{$SIGWIDE_SITE_HOST} {
	root * /srv/site
	file_server
}

# The panel.
{$SIGWIDE_HOST} {
	encode zstd gzip
	reverse_proxy web:3000
}

# The mail relay's name. Caddy only fetches and renews its certificate; the relay (port 25) reads it.
{$SIGWIDE_RELAY_HOST} {
	respond "Sigwide mail relay" 200
}
