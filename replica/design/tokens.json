      "sans": "Arial, Helvetica, sans-serif",
      "humanist": "Verdana, Geneva, sans-serif",
      "modern": "\"Segoe UI\", Tahoma, Arial, sans-serif",
      "serif": "Georgia, \"Times New Roman\", serif"
    },
    "font_size_px": {"min": 11, "body": 13, "name": 16, "max": 20},
    "line_height": 1.35,
    "max_width_px": 600,
    "image": {"formats": ["png", "jpeg", "gif"], "scale": 2, "max_bytes": 2000000, "logo_max_height_px": 80, "photo_px": 96},
    "social_icon_px": 20,
    "default_colors": {"text": "#222222", "muted": "#666666", "link": "#0b6e69", "divider": "#dddddd"}
  }
