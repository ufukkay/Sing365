  "shadow": {
    "card": "0 1px 2px rgba(18,26,33,.06), 0 1px 3px rgba(18,26,33,.08)",
    "pop": "0 10px 28px rgba(18,26,33,.16)"
  },
  "motion": {"fast": "120ms", "base": "180ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
  "layout": {
    "sidebar": 248,
    "sidebar-collapsed": 64,
    "header": 56,
