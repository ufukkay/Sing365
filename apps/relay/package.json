{
  "name": "@sing365/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/relay.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/relay.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sing365/stamp": "workspace:*",
    "nodemailer": "^10.6.1",
    "smtp-server": "^3.21.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.28.2",
    "mailparser": "^3.15.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
