# --- Database (Postgres). Without it the panel runs on seed data for a local demo.
# Leave empty when using `pnpm dev:local`: it starts a local database and sets this itself.
DATABASE_URL=
# --- Microsoft Entra app registration (multi-tenant)
ENTRA_CLIENT_ID=
# Create under Certificates & secrets. Keep it only here (.env.local) or in the host's secret store.
ENTRA_CLIENT_SECRET=
# Optional: Application ID URI from "Expose an API" (api://<host>/<client id>) for Outlook SSO tokens
ENTRA_API_AUDIENCE=
# --- Sessions: 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# --- Scheduled sync: the cron caller sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# --- Public HTTPS origin of the web app (sign-in redirects, add-in manifest)
SING365_PUBLIC_URL=http://localhost:3000
# A GUID you generate once for the Outlook add-in manifest
SING365_ADDIN_ID=
# Local development only: trusts the add-in's `from` against the seed tenant. Never set in production.
SING365_DEV_AUTH=
